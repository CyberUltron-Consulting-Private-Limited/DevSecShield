# deploy/staging/backend.env: secrets only the backend-image containers need (API, migrate, CBOM cloud worker,
# DAST scheduler). Copy to backend.env (git-ignored), chmod 600, set real values. Full list with comments:
# backend/.env.example. DSS_DEV_MODE and LOCAL_DEV_VERIFICATION_* must never be set on staging.

# Two different random values, 32+ bytes each: openssl rand -hex 32
JWT_SECRET_KEY=
JWT_REFRESH_SECRET_KEY=
# Fernet key for stored credentials: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Set it before the first start: unset, it is derived from JWT_SECRET_KEY (see docs/security/secret-rotation.md).
ENCRYPTION_KEY=
CERTIN_HMAC_SECRET=
# BOM signing (D11): ES256 key that signs every CycloneDX BOM, VEX and evidence pack; public key at
# GET /{team}/bom-signing-keys. Unset: derived from CERTIN_HMAC_SECRET (stable per deployment, nothing stored), which must
# then be 32+ random bytes (openssl rand -hex 32), not a placeholder; staging.sh checks this before a deploy. Rotation:
# docs/security/secret-rotation.md ("BOM signing key"). Or give a P-256 PEM private key
# inline (e.g. from Secrets Manager) or a file path (generated there once, 0600, if missing). Rotate with
# CBOM_SIGNING_KEY_GENERATION=2 (derived) or CBOM_SIGNING_RETIRED_PUBLIC_KEYS=<pem bundle> (configured keys).
# CBOM_SIGNING_KEY_PEM=
# CBOM_SIGNING_KEY_PATH=
# CBOM_SIGNING_KEY_ID=


# The browser origin of the frontend (https:// when certificates are mounted).
CORS_ORIGINS=https://devsec-staging.zeroshield.ai
CBOM_PUBLIC_APP_URL=https://devsec-staging.zeroshield.ai

# Mail for sign-in codes: an SMTP relay (SMTP_SECURITY starttls | ssl | none) ...
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=
# ... or Microsoft Graph when SMTP_HOST is empty.
TENANT_ID=
CLIENT_ID=
CLIENT_SECRET=
EMAIL_SENDER=

# CBOM AWS sources: ZeroShield's collector credentials and principal (README "AWS collection on staging"). The Deploy
# staging workflow sets these four from the `staging` environment's secrets when they are set there.
CBOM_AWS_ACCESS_KEY_ID=
CBOM_AWS_SECRET_ACCESS_KEY=
CBOM_AWS_PRINCIPAL_ARN=
# Lab mode, test deployments only: 1 = accept a customer role in this deployment's own AWS account (still requires the
# external ID and the data-plane deny; banners on the form and every run; refused unless DSS_ENV names a test
# deployment, which docker-compose.yml sets to staging).
CBOM_AWS_LAB_SAME_ACCOUNT=
# AI remediation assistant and AI fix generation (README "AI remediation"): bedrock = AWS Bedrock Converse in
# CBOM_AI_BEDROCK_REGION. Credentials: the assistant's own IAM user in CBOM_AI_AWS_ACCESS_KEY_ID /
# CBOM_AI_AWS_SECRET_ACCESS_KEY (source static, the default when they are set; bedrock:InvokeModel on
# openai.gpt-oss-120b-1:0 only), else the AWS_* of .env (CBOM_AI_AWS_CREDENTIALS=env). The Deploy staging workflow sets
# these from the `staging` environment (provider only when its variable is set; region default ap-south-1; source
# static with both key secrets, else not written; empty secrets leave the values here). CBOM_AI_PROVIDER=off turns it off.
# Egress: https to bedrock-runtime.ap-south-1.amazonaws.com:443 only.
CBOM_AI_PROVIDER=
CBOM_AI_BEDROCK_REGION=
CBOM_AI_AWS_CREDENTIALS=
CBOM_AI_AWS_ACCESS_KEY_ID=
CBOM_AI_AWS_SECRET_ACCESS_KEY=
# Certificate Transparency discovery (README "Certificate Transparency discovery on staging"). Not a secret.
# The Deploy staging workflow writes 1 here unless the staging environment variable CBOM_CT_DISCOVERY is set
# (0 turns it off). Leave this empty on any other deployment: the code's default is off. Do not put a secret here.
CBOM_CT_DISCOVERY=
# Settings > Integrations destinations on private networks (on-prem Splunk, syslog, ServiceNow): CIDRs and/or host
# names (README "Integrations"). Without it every private destination is refused.
INTEGRATION_ALLOWED_PRIVATE=
# DAST_ALLOWED_PRIVATE (DAST targets on private networks) lives in .env: the DAST worker reads it too. A value set
# here would win for the backend only, and the worker would then refuse those targets.
# IdP metadata on private networks (CIDRs and/or host names) and a private CA bundle for it.
CBOM_IDP_ALLOWED_PRIVATE=
CBOM_EXTRA_CA_FILE=
# Scan-node mTLS (README "Scan-node mTLS"): 1 = read nginx's X-ZS-Client-* headers (only while the backend port is
# reachable through nginx alone); REQUIRED refuses node calls without a verified client certificate; PIN holds each
# node to the certificate it enrolled with.
CBOM_MTLS_HEADER_TRUSTED=
CBOM_MTLS_REQUIRED=
CBOM_MTLS_PIN=
# SSH CA keys at rest (backend/utilities/cbom_sources/sshca/keywrap.py): the AWS KMS key ARNs a team may pick,
# comma-separated, the first is the default for new CAs (empty: the CA keys are wrapped with ENCRYPTION_KEY).
CBOM_SSHCA_KMS_KEY_ARNS=
# DR only: send calls for a multi-Region key (key/mrk-...) to its replica in another region, as mrk-<key id>=<region>
# entries, comma-separated, or *=<region> for every multi-Region key. KMS_KEY_ARNS and the stored CAs keep the primary
# ARN; single-Region keys keep their own region. A malformed entry makes CA key use fail with a message naming it.
CBOM_SSHCA_KMS_REGION_OVERRIDE=
# Certificate identity re-key window (q109certkey001, #504): hours after a team's key move during which every store
# write also re-keys rows an older-release process wrote under the old identity; then the scheduler makes one last
# pass and later writes skip it. Default 24, clamped to 1..720; a non-number, inf, NaN or negative value is refused
# (default used, logged once). An older worker writing AFTER the window would leave a duplicate "removed" asset and
# a Q0 item closed as "observation": raise this before a long or staggered rollout (compose deploys recreate every
# container, so none is left).
CBOM_IDENTITY_WINDOW_HOURS=
