# DevSecShield Environment Variables Template
# Copy this file to .env and fill in your values
# NEVER commit .env files to version control

# ==================== Database ====================
PG_USER=your_postgres_user
PG_USER_PASS=your_postgres_password
PG_DB=devsecshield_db
PG_HOST=localhost
PG_PORT=5432

MONGO_INITDB_ROOT_USERNAME=your_mongo_user
MONGO_INITDB_ROOT_PASSWORD=your_mongo_password
MONGO_HOST=localhost
MONGO_PORT=27017

# ==================== Message Queue ====================
RABBIT_ADMIN_USERNAME=your_rabbitmq_user
RABBIT_ADMIN_PASSWORD=your_rabbitmq_password
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672

# ==================== Authentication ====================
JWT_SECRET_KEY=generate_a_secure_random_256_bit_key
JWT_REFRESH_SECRET_KEY=generate_another_secure_random_256_bit_key

# ==================== CORS ====================
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:4000

# ==================== API Keys (Optional) ====================
# OPENAI_API_KEY=sk-your-openai-key
# AWS_ACCESS_KEY_ID=your-aws-access-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret-key
# QDRANT_API_KEY=your-qdrant-key

# ==================== Email (Optional) ====================
# EMAIL_HOST=smtp.example.com
# EMAIL_USER=your-email@example.com
# EMAIL_PASSWORD=your-email-password

# ==================== Encryption ====================
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=generate_a_fernet_key

# ==================== Docker ====================
IS_DOCKER_CONTAINER=False
