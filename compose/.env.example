# compose/docker-compose.yml (infrastructure: RabbitMQ, MongoDB, PostgreSQL). Put real values in compose/.env and
# never commit them (docs/security/secret-rotation.md).
#
# The application stacks read their own env files in their own project directories:
#   compose/main/.env           backend + CBOM cloud worker: see backend/.env.example, plus ECR_REGISTRY and TAG
#   compose/worker-compose/.env workers: see compose/worker-compose/.env.example
# A self-contained production-image stack (all services, nginx, TLS) is in deploy/staging/.

RABBIT_ADMIN_USERNAME=devsecshield
RABBIT_ADMIN_PASSWORD=change-me
MONGO_INITDB_ROOT_USERNAME=devsecshield
MONGO_INITDB_ROOT_PASSWORD=change-me
PG_USER=devsecshield
PG_USER_PASS=change-me
PG_DB=devsecshield
