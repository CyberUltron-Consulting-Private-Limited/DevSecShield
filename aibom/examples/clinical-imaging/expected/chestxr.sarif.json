{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "clinithread-aibom",
          "version": "0.1.0",
          "informationUri": "https://github.com/devsecshield/clinithread-aibom",
          "rules": [
            {
              "id": "DATASET_NO_DEIDENT",
              "name": "DatasetNotDeidentified",
              "shortDescription": {
                "text": "Training dataset shows no evidence of de-identification; HIPAA de-identification of PHI is required."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "helpUri": "https://github.com/devsecshield/clinithread-aibom#dataset_no_deident"
            },
            {
              "id": "MODEL_EU_AI_ACT_HIGH_RISK",
              "name": "EuAiActHighRisk",
              "shortDescription": {
                "text": "EU AI Act high-risk AI system requires Annex IV technical documentation and MDR/IVDR alignment."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "helpUri": "https://github.com/devsecshield/clinithread-aibom#model_eu_ai_act_high_risk"
            },
            {
              "id": "MODEL_NO_LICENSE",
              "name": "ConcludedLicenseMissing",
              "shortDescription": {
                "text": "AI model component has no declared license; a concluded license is required for SPDX/\u00a7524B."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "helpUri": "https://github.com/devsecshield/clinithread-aibom#model_no_license"
            },
            {
              "id": "MODEL_PHI_AT_INFERENCE",
              "name": "PhiAtInference",
              "shortDescription": {
                "text": "Model processes sensitive personal information (PHI) at inference; HIPAA BAA and \u00a7524B security risk analysis required."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "helpUri": "https://github.com/devsecshield/clinithread-aibom#model_phi_at_inference"
            }
          ]
        }
      },
      "properties": {
        "advisoryDisclaimer": "Regulatory mappings are advisory only; an AI BOM creates visibility, not assurance, and does not by itself satisfy FDA, EU AI Act, or HIPAA obligations. A qualified regulatory reviewer must sign off."
      },
      "results": [
        {
          "ruleId": "MODEL_EU_AI_ACT_HIGH_RISK",
          "ruleIndex": 1,
          "level": "warning",
          "message": {
            "text": "Model 'chestxr-nodule-detector' is EU AI Act high-risk (high-risk (Annex I / MDR)); Annex IV technical documentation required."
          },
          "locations": [
            {
              "logicalLocations": [
                {
                  "name": "model-chestxr-cnn",
                  "fullyQualifiedName": "model-chestxr-cnn"
                }
              ]
            }
          ]
        },
        {
          "ruleId": "MODEL_PHI_AT_INFERENCE",
          "ruleIndex": 3,
          "level": "warning",
          "message": {
            "text": "Model 'chestxr-nodule-detector' uses sensitive personal information (PHI) at inference; HIPAA BAA + \u00a7524B risk analysis required."
          },
          "locations": [
            {
              "logicalLocations": [
                {
                  "name": "model-chestxr-cnn",
                  "fullyQualifiedName": "model-chestxr-cnn"
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
