#!/bin/sh
# One JSON line per accepted connection (INTERFACES v1 §4): {"ts","peer","local"}. Runs in socat's forked child.
printf '{"ts":"%s","peer":"%s:%s","local":"%s:%s"}\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
  "${SOCAT_PEERADDR:-?}" "${SOCAT_PEERPORT:-?}" "${SOCAT_SOCKADDR:-?}" "${SOCAT_SOCKPORT:-?}" >> "${CB02_LISTENER_LOG:-/dev/stderr}"
