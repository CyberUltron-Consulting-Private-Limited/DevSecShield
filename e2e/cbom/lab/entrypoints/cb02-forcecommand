#!/bin/sh
# ForceCommand logger (oracle rule O-8, "read-only commands"): every command a login runs is recorded as one JSON line
# {"ts","user","peer","command"} in /var/log/cb02/commands.log (lab/forcecommand.log in the run directory) and in the
# container log, then executed. The harness compares the record with the command allow-list the product publishes.
cmd=${SSH_ORIGINAL_COMMAND:-<interactive>}
esc=$(printf '%s' "$cmd" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' -e 's/\t/\\t/g' | awk 'NR > 1 { printf "\\n" } { printf "%s", $0 }')
line=$(printf '{"ts":"%s","user":"%s","peer":"%s","command":"%s"}' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$(id -un)" \
  "${SSH_CONNECTION%% *}" "$esc")
printf '%s\n' "$line" >> /var/log/cb02/commands.log
printf 'cb02-cmd %s\n' "$line" > /proc/1/fd/2 2>/dev/null || true
case "$cmd" in
  "<interactive>") exec /bin/sh -l ;;
  sftp|internal-sftp) exec /usr/lib/ssh/sftp-server ;;
  *) exec /bin/sh -c "$cmd" ;;
esac
