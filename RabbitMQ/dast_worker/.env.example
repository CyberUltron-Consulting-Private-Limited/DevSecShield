# DevSecShield DAST worker image (dast_worker_queue). Names come from the code's os.getenv/os.environ reads.
# Placeholder values only; never commit real values (docs/security/secret-rotation.md).

IS_DOCKER_CONTAINER=True

# --- RabbitMQ (Celery broker) --------------------------------------------------------------------------------------
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBIT_ADMIN_USERNAME=devsecshield
RABBIT_ADMIN_PASSWORD=change-me

# --- MongoDB (Celery results, findings) ------------------------------------------------------------------------------
# Either a full URL, or leave it empty and the worker builds it from the MONGO_* values below.
RABBIT_MONGO_CONNECTION_URL=
MONGO_HOST=mongo
MONGO_PORT=27017
MONGO_INITDB_ROOT_USERNAME=devsecshield
MONGO_INITDB_ROOT_PASSWORD=change-me

# --- AWS Bedrock (AI-assisted triage) ----------------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-south-1

# 1 = kill leftover headless browsers after each Nuclei run (default on inside containers).
DAST_REAP_BROWSERS=1
