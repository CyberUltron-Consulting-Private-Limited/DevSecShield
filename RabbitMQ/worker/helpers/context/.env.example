# Context helpers (S3, Qdrant, tracing) for a source checkout. load_dotenv reads .env in the working directory.
# From this directory:
#   cp .env.example .env
# .env is git-ignored. Placeholders only; never commit real values (docs/security/secret-rotation.md).
# Staging does not read this file. Workers get the host deploy/staging/.env through compose.

OPENAI_API_KEY=
MONGO_INITDB_ROOT_USERNAME=MongoAdmin
MONGO_INITDB_ROOT_PASSWORD=change-me
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-south-1
QDRANT_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=DevSecShield-Tracing
