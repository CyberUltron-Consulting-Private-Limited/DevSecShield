# Credentials for a source checkout of backend/utilities/ai (load_dotenv reads .env in the working directory).
# From this directory:
#   cp .env.example .env
# .env is git-ignored. Placeholders only; never commit real values (docs/security/secret-rotation.md).
# Staging does not read this file. It uses /opt/devsecshield-staging/deploy/staging/backend.env.

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-south-1
OPENAI_API_KEY=
