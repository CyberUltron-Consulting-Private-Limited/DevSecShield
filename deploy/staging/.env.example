# deploy/staging/.env: shared values. Compose reads it for ${...} in docker-compose.yml, and every application
# container (backend image and workers) gets it as environment. Copy to .env (git-ignored), chmod 600, set real
# values. API-only secrets go in backend.env. DSS_DEV_MODE must never be set on staging.

# --- images (scripts/deploy/staging.sh writes DSS_TAG for each deploy) ------------------------------------------------
DSS_IMAGE_PREFIX=dss-staging
DSS_TAG=
# MINIO_IMAGE=minio/minio:RELEASE.2025-04-22T22-12-26Z

# --- public names and ports (nginx) -------------------------------------------------------------------------------------
FRONTEND_HOST=devsec-staging.zeroshield.ai
API_HOST=devsec-staging-api.zeroshield.ai
HTTP_PORT=80
HTTPS_PORT=443
HTTP_BIND=0.0.0.0
# Directory holding fullchain.pem + privkey.pem (TLS on when both exist; plain HTTP otherwise).
TLS_CERT_DIR=./certs
# nginx's fixed address on the edge network; the backend trusts X-Forwarded-For only from it.
DSS_EDGE_SUBNET=172.30.250.0/24
DSS_PROXY_IP=172.30.250.10
BACKEND_WORKERS=4
DAST_MEM_LIMIT=4g

# --- in-stack host names ---------------------------------------------------------------------------------------------------
IS_DOCKER_CONTAINER=True
PG_HOST=postgres
PG_PORT=5432
MONGO_HOST=mongo
MONGO_PORT=27017
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672

# --- infrastructure credentials (openssl rand -hex 24) ----------------------------------------------------------------------
PG_USER=devsecshield
PG_USER_PASS=change-me
PG_DB=devsecshield
MONGO_INITDB_ROOT_USERNAME=devsecshield
MONGO_INITDB_ROOT_PASSWORD=change-me
RABBIT_ADMIN_USERNAME=devsecshield
RABBIT_ADMIN_PASSWORD=change-me

# --- object storage and Bedrock ----------------------------------------------------------------------------------------------
# Real S3: an IAM user/role for the bucket devsecshield-storage, AWS_ENDPOINT_URL_S3 empty.
# Local MinIO (compose profile "minio"): these two become the MinIO root credentials (8+ characters) and
# AWS_ENDPOINT_URL_S3=http://minio:9000.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-south-1
AWS_ENDPOINT_URL_S3=

# --- air gap ---------------------------------------------------------------------------------------------------------------------
# Self-hosted Git servers for repository scans (backend and scan workers): host[:port] or http://host[:port].
GIT_ALLOWED_HOSTS=
