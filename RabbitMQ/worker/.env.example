# DevSecShield scan worker image (scan_worker_queue and cicd_worker_queue). Names come from the code's
# os.getenv/os.environ reads. Placeholder values only; never commit real values (docs/security/secret-rotation.md).

IS_DOCKER_CONTAINER=True

# --- RabbitMQ (Celery broker) --------------------------------------------------------------------------------------
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBIT_ADMIN_USERNAME=devsecshield
RABBIT_ADMIN_PASSWORD=change-me

# --- MongoDB (Celery results, findings) ------------------------------------------------------------------------------
# Either a full URL, or leave it empty and the worker builds it from the MONGO_* values below.
RABBIT_MONGO_CONNECTION_URL=
MONGO_HOST=mongo
MONGO_PORT=27017
MONGO_INITDB_ROOT_USERNAME=devsecshield
MONGO_INITDB_ROOT_PASSWORD=change-me

# --- AWS: S3 uploads (bucket devsecshield-storage) and Bedrock ------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-south-1
# S3-compatible endpoint (MinIO) instead of AWS S3, e.g. http://minio:9000.
AWS_ENDPOINT_URL_S3=
# Bedrock model id for the AI-assisted scan types (default openai.gpt-oss-120b-1:0).
LLM_MODEL=

# --- source repositories ------------------------------------------------------------------------------------------------
# Self-hosted Git servers allowed besides github.com, gitlab.com and bitbucket.org: comma list of host or host:port
# (https), or http://host[:port] for plain HTTP to that host only. Must match the backend's value.
GIT_ALLOWED_HOSTS=

# --- vector store (AI-assisted SAST context) ------------------------------------------------------------------------------
QDRANT_HOST=
QDRANT_PORT=6333
QDRANT_API_KEY=

# --- engine tuning ----------------------------------------------------------------------------------------------------------
# Celery threads in this container (semgrep sizes its jobs from it).
CELERY_WORKER_CONCURRENCY=
SEMGREP_JOBS=
SEMGREP_MAX_MEMORY_MB=
SEMGREP_RULE_TIMEOUT_SECONDS=
SEMGREP_SUBPROCESS_TIMEOUT_SECONDS=
SEMGREP_TIMEOUT_THRESHOLD=
# Scratch directory for clones and extracted uploads.
TMPDIR=
# Signed CBOM knowledge-base update for the engine: bundle path, signature path, trusted public keys.
CBOM_KB_BUNDLE=
CBOM_KB_BUNDLE_SIG=
CBOM_KB_PUBKEYS=
