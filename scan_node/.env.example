# ZeroShield CBOM scan node (scan_node image / python -m zs_scan_node). Names come from zs_scan_node's
# os.environ reads. Placeholder values only; pass them with `docker run --env-file` and never commit real values.

# ZeroShield API base URL (https:// required).
ZS_API_URL=https://devsecshieldapi.zeroshield.ai
# Single-use token from "Add scan node"; needed only until the node has enrolled.
ZS_REGISTRATION_TOKEN=
# Persistent state (node identity and token). Mount a volume here.
ZS_STATE_DIR=/var/lib/zs-node
# Jobs run in parallel (1..8, default 2).
ZS_MAX_JOBS=2
# Local test labs only: 1 = allow an http:// ZS_API_URL (credentials would travel unencrypted).
ZS_ALLOW_INSECURE_HTTP=
# Vault credential references are allowed only under this path prefix (vault use is off without it).
ZS_VAULT_PATH_PREFIX=
# HashiCorp Vault for vault credential references (AWS Secrets Manager uses the node's IAM role instead).
VAULT_ADDR=
VAULT_TOKEN=
