# DevSecShield backend (API, migrate one-shot, CBOM cloud worker, DAST scheduler: all run the backend image).
# Names come from the code's os.getenv/os.environ reads. Placeholder values only: copy to .env (git-ignored) or pass
# them as container environment. Never commit real values (docs/security/secret-rotation.md).

# --- runtime -------------------------------------------------------------------------------------------------------
# "True" inside the image (set by the Dockerfile); switches default host names to the compose service names.
IS_DOCKER_CONTAINER=True
# Dev-only switches (sign-in code from LOCAL_DEV_VERIFICATION_*). Never set on staging or production.
# DSS_DEV_MODE=1
# LOCAL_DEV_VERIFICATION_EMAIL=dev@example.com
# LOCAL_DEV_VERIFICATION_CODE=000000
# Comma-separated browser origins allowed by CORS (the frontend URL).
CORS_ORIGINS=https://devsecshield.example.com
# Proxy addresses/CIDRs whose X-Forwarded-For/-Proto gunicorn trusts (read by gunicorn itself).
FORWARDED_ALLOW_IPS=127.0.0.1
# 1 = this container never runs `alembic upgrade head` at start (workers, or when a migrate one-shot does it).
SKIP_ALEMBIC=
# Upper bound in seconds for the start-up migration, including waiting for another migrator's lock.
ALEMBIC_TIMEOUT_S=300

# --- PostgreSQL ----------------------------------------------------------------------------------------------------
PG_HOST=postgres
PG_PORT=5432
PG_USER=devsecshield
PG_USER_PASS=change-me
PG_DB=devsecshield

# --- MongoDB (findings, logs, Celery results) ------------------------------------------------------------------------
MONGO_HOST=mongo
MONGO_PORT=27017
MONGO_INITDB_ROOT_USERNAME=devsecshield
MONGO_INITDB_ROOT_PASSWORD=change-me

# --- RabbitMQ (Celery broker) ------------------------------------------------------------------------------------------
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBIT_ADMIN_USERNAME=devsecshield
RABBIT_ADMIN_PASSWORD=change-me

# --- tokens and stored-secret encryption --------------------------------------------------------------------------------
# Two different random values, at least 32 bytes each (openssl rand -hex 32).
JWT_SECRET_KEY=change-me-to-64-hex-characters
JWT_REFRESH_SECRET_KEY=change-me-to-another-64-hex-characters
# Fernet key for stored credentials (python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())").
# Unset = derived from JWT_SECRET_KEY, so rotating the JWT secret would make stored credentials unreadable.
ENCRYPTION_KEY=
# HMAC key for CERT-In attestation hashes (falls back to JWT_SECRET_KEY when unset).
CERTIN_HMAC_SECRET=change-me

# --- e-mail (sign-in codes, invites) ------------------------------------------------------------------------------------
# SMTP relay (used when SMTP_HOST is set). SMTP_SECURITY: starttls | ssl | none. SMTP_CA_FILE trusts a private CA.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TIMEOUT_S=20
SMTP_CA_FILE=
MAIL_FROM=no-reply@example.com
# Microsoft Graph sendMail (used when SMTP_HOST is unset).
TENANT_ID=
CLIENT_ID=
CLIENT_SECRET=
EMAIL_SENDER=no-reply@example.com
# Legacy Gmail SMTP path (send_email); app password of EMAIL_SENDER.
EMAIL_PASSWORD=

# --- AWS: S3 uploads (bucket devsecshield-storage) and Bedrock ------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-south-1
AWS_SESSION_TOKEN=
# S3-compatible endpoint (MinIO) instead of AWS S3, e.g. http://minio:9000.
AWS_ENDPOINT_URL_S3=

# --- CBOM ---------------------------------------------------------------------------------------------------------------
# ZeroShield's own AWS credentials and principal for customer AWS sources (role assumption, template validation).
CBOM_AWS_ACCESS_KEY_ID=
CBOM_AWS_SECRET_ACCESS_KEY=
CBOM_AWS_SESSION_TOKEN=
CBOM_AWS_PRINCIPAL_ARN=arn:aws:iam::123456789012:role/zeroshield-cbom-collector
# Public URL of the web app (vendor questionnaire links).
CBOM_PUBLIC_APP_URL=https://devsecshield.example.com
# 1 = allow the AI chat on CBOM scans (off by default: CBOM runs without an AI model).
CBOM_ALLOW_LLM=
# AI remediation assistant (optional; see deploy/local/README.md "AI remediation assistant"). Bedrock (only outbound
# call: https to bedrock-runtime.<region>.amazonaws.com): CBOM_AI_PROVIDER=bedrock, CBOM_AI_BEDROCK_REGION,
# CBOM_AI_MODEL (default openai.gpt-oss-120b-1:0), CBOM_AI_AWS_PROFILE, CBOM_AI_BEDROCK_ENDPOINT_URL (PrivateLink).
# Or a model on your network: CBOM_AI_BASE_URL=http://ollama:11434/v1 and CBOM_AI_MODEL=qwen3:8b.
CBOM_AI_PROVIDER=
CBOM_AI_BEDROCK_REGION=
CBOM_AI_AWS_PROFILE=
CBOM_AI_BASE_URL=
CBOM_AI_MODEL=
# Signed knowledge-base update: bundle path, signature path (default <bundle>.sig), trusted public keys.
CBOM_KB_BUNDLE=
CBOM_KB_BUNDLE_SIG=
CBOM_KB_PUBKEYS=
# Identity-provider metadata on a private network: comma list of CIDRs and/or host names the IdP collector may
# reach. Loopback, link-local (cloud metadata) and CGNAT stay blocked whatever is listed.
CBOM_IDP_ALLOWED_PRIVATE=
# Extra CA bundle (PEM) trusted for IdP metadata over https (private CA). CBOM_LAB_CA_FILE is the old name.
CBOM_EXTRA_CA_FILE=
# Local test labs only, never production: 1 = IdP fetches may reach any RFC 1918 / unique-local address.
CBOM_LAB_ALLOW_PRIVATE_FETCH=

# --- source repositories ------------------------------------------------------------------------------------------------
# Self-hosted Git servers allowed for repository scans, besides github.com, gitlab.com and bitbucket.org:
# comma list of host or host:port (https), or http://host[:port] to allow plain HTTP for that host only.
# Set the same value on the scan workers.
GIT_ALLOWED_HOSTS=

# --- integrations ---------------------------------------------------------------------------------------------------------
# Self-hosted Jira host names (comma list) besides *.atlassian.net, *.atlassian.com and *.jira.com.
ALLOWED_JIRA_HOSTS=
# SBOM registry lookups: 0 = never call public registries (air gap).
DSS_SBOM_REGISTRY=
# Optional API tokens that raise public rate limits for SBOM advisories / registry lookups.
GITHUB_TOKEN=
GH_TOKEN=
NVD_API_KEY=
