# compose/worker-compose/docker-compose.yml. Copy to compose/worker-compose/.env and set real values; never commit
# them (docs/security/secret-rotation.md). Compose reads this file for ${...} interpolation and the worker services
# load it as their environment (the images no longer carry a .env). Worker variables: RabbitMQ/worker/.env.example,
# RabbitMQ/dast_worker/.env.example, RabbitMQ/guardrail_worker/.env.example.

ECR_REGISTRY=123456789012.dkr.ecr.ap-south-1.amazonaws.com
TAG=latest

# Celery result backend for every worker (the Mongo service of compose/docker-compose.yml).
RABBIT_MONGO_CONNECTION_URL=mongodb://devsecshield:change-me@devsecshield-mongodb:27017/
RABBIT_ADMIN_USERNAME=devsecshield
RABBIT_ADMIN_PASSWORD=change-me
MONGO_INITDB_ROOT_USERNAME=devsecshield
MONGO_INITDB_ROOT_PASSWORD=change-me
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-south-1
GIT_ALLOWED_HOSTS=
