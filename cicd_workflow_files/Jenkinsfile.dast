pipeline {
    agent any

    environment {
        CICD_API_KEY = credentials('CICD_API_KEY')
        DAST_API_URL = 'https://devsecshieldapi.zeroshield.ai/cicd/dast/scan'
    }

    stages {
        stage('Deploy') {
            steps {
                echo 'Deploy the application to the staging URL this DAST profile targets.'
            }
        }

        stage('DAST fire-and-forget') {
            steps {
                script {
                    def profileId = env.DAST_PROFILE_ID
                    if (!profileId?.trim()) {
                        error('Set DAST_PROFILE_ID on the Jenkins job (saved DevSecShield DAST profile id).')
                    }
                    def payload = "{\"profile_id\": ${profileId}}"
                    if (env.DAST_TARGET_URL?.trim()) {
                        payload = "{\"profile_id\": ${profileId}, \"target_url\": \"${env.DAST_TARGET_URL}\"}"
                    }
                    // --fail-with-body (curl 7.76+): an HTTP error fails the build and still prints the reason.
                    // 429 (rate limited): wait Retry-After seconds (30 if absent, 300 at most), up to 5 tries.
                    writeFile(file: 'devsecshield-dast-request.json', text: payload)
                    sh '''#!/bin/bash
set -uo pipefail
for attempt in 1 2 3 4 5; do
  rc=0
  code=$(curl --fail-with-body -sS --max-time 120 -o devsecshield-dast-response.json -D devsecshield-headers.txt \
    -w '%{http_code}' -H "cicd-api-key: ${CICD_API_KEY}" -H "Content-Type: application/json" \
    --data @devsecshield-dast-request.json "${DAST_API_URL}") || rc=$?
  if [ "${code}" = "429" ] && [ "${attempt}" -lt 5 ]; then
    delay=$(awk 'tolower($1) == "retry-after:" {print $2 + 0}' devsecshield-headers.txt | tail -n 1)
    [ -n "${delay}" ] && [ "${delay}" -gt 0 ] || delay=30
    [ "${delay}" -le 300 ] || delay=300
    echo "DevSecShield is rate limiting this key; retrying in ${delay}s (attempt ${attempt} of 5)"
    sleep "${delay}"
    continue
  fi
  break
done
if [ "${rc}" -ne 0 ]; then
  echo "DAST dispatch failed (curl exit ${rc}, HTTP ${code:-none}):"
  cat devsecshield-dast-response.json 2>/dev/null || true
  exit 1
fi
'''
                    def response = readFile('devsecshield-dast-response.json').trim()
                    echo "DAST dispatch: ${response}"
                    def jsonResponse = readJSON(text: response)
                    if (!jsonResponse.scan_id) {
                        error("DAST dispatch did not return scan_id: ${response}")
                    }
                    env.DAST_SCAN_ID = jsonResponse.scan_id.toString()
                }
            }
        }

        // Optional wait-and-gate: uncomment to fail the build on High/Critical.
        // stage('DAST wait-and-gate') {
        //     steps {
        //         timeout(time: 30, unit: 'MINUTES') {
        //             script {
        //                 def terminal = false
        //                 while (!terminal) {
        //                     def statusJson = sh(script: '''
        //                         curl -sS -H "cicd-api-key: $CICD_API_KEY" \
        //                           "$DAST_API_URL/$DAST_SCAN_ID"
        //                     ''', returnStdout: true).trim()
        //                     def body = readJSON(text: statusJson)
        //                     echo "DAST status=${body.status} gate_failed=${body.gate_failed}"
        //                     if (body.status == 'success' || body.status == 'failure') {
        //                         terminal = true
        //                         if (body.status == 'failure') {
        //                             error("DAST scan failed: ${body.info}")
        //                         }
        //                         if (body.gate_failed) {
        //                             error('DAST gate failed: High/Critical findings present')
        //                         }
        //                     } else {
        //                         sleep time: 20, unit: 'SECONDS'
        //                     }
        //                 }
        //             }
        //         }
        //     }
        // }
    }
}
