# deploy/staging/backend.env: secrets only the backend-image containers need (API, migrate, CBOM cloud worker,
# DAST scheduler). Copy to backend.env (git-ignored), chmod 600, set real values. Full list with comments:
# backend/.env.example. DSS_DEV_MODE and LOCAL_DEV_VERIFICATION_* must never be set on staging.

# Two different random values, 32+ bytes each: openssl rand -hex 32
JWT_SECRET_KEY=
JWT_REFRESH_SECRET_KEY=
# Fernet key for stored credentials: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Set it before the first start: unset, it is derived from JWT_SECRET_KEY (see docs/security/secret-rotation.md).
ENCRYPTION_KEY=
CERTIN_HMAC_SECRET=

# The browser origin of the frontend (https:// when certificates are mounted).
CORS_ORIGINS=https://devsec-staging.zeroshield.ai
CBOM_PUBLIC_APP_URL=https://devsec-staging.zeroshield.ai

# Mail for sign-in codes: an SMTP relay (SMTP_SECURITY starttls | ssl | none) ...
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=
# ... or Microsoft Graph when SMTP_HOST is empty.
TENANT_ID=
CLIENT_ID=
CLIENT_SECRET=
EMAIL_SENDER=

# CBOM AWS sources: ZeroShield's collector credentials and principal.
CBOM_AWS_ACCESS_KEY_ID=
CBOM_AWS_SECRET_ACCESS_KEY=
CBOM_AWS_PRINCIPAL_ARN=
# Settings > Integrations destinations on private networks (on-prem Splunk, syslog, ServiceNow): CIDRs and/or host
# names (README "Integrations"). Without it every private destination is refused.
INTEGRATION_ALLOWED_PRIVATE=
# IdP metadata on private networks (CIDRs and/or host names) and a private CA bundle for it.
CBOM_IDP_ALLOWED_PRIVATE=
CBOM_EXTRA_CA_FILE=
# Scan-node mTLS (README "Scan-node mTLS"): 1 = read nginx's X-ZS-Client-* headers (only while the backend port is
# reachable through nginx alone); REQUIRED refuses node calls without a verified client certificate; PIN holds each
# node to the certificate it enrolled with.
CBOM_MTLS_HEADER_TRUSTED=
CBOM_MTLS_REQUIRED=
CBOM_MTLS_PIN=
