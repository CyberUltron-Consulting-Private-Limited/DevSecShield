# deploy/local/.env: settings of the local stack (deploy/local/README.md). Placeholders only in this file.
#   deploy/local/init-env.sh      copies this file to .env (git-ignored, mode 600) and replaces every change-me with a
#                                 fresh random value. Or copy it yourself and replace each change-me by hand.
# Compose reads it for ${...} in docker-compose.yml and every application container gets it as its environment.

# --- which images -------------------------------------------------------------------------------------------------
# dev | staging | pr-<n> (a PR labelled publish-preview) | an immutable tag such as dev-<sha12> (README "Tags")
DSS_TAG=dev
# DSS_REGISTRY=ghcr.io/cyberultron-consulting-private-limited

# --- what this machine exposes (127.0.0.1 = this machine only) ---------------------------------------------------
# UI on :3000, API on :8000, Mailpit on :8025. A scan node on ANOTHER machine needs API_BIND=0.0.0.0 (or this
# machine's LAN address); see README "Scan node".
UI_BIND=127.0.0.1
API_BIND=127.0.0.1
MAIL_BIND=127.0.0.1
BACKEND_WORKERS=2
DAST_MEM_LIMIT=2g

# --- in-stack host names (compose service names) ------------------------------------------------------------------
IS_DOCKER_CONTAINER=True
PG_HOST=postgres
PG_PORT=5432
MONGO_HOST=mongo
MONGO_PORT=27017
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672

# --- infrastructure credentials (local containers only) ------------------------------------------------------------
PG_USER=devsecshield
PG_USER_PASS=change-me
PG_DB=devsecshield
MONGO_INITDB_ROOT_USERNAME=devsecshield
MONGO_INITDB_ROOT_PASSWORD=change-me
RABBIT_ADMIN_USERNAME=devsecshield
RABBIT_ADMIN_PASSWORD=change-me

# --- object storage: the local MinIO (these two are its root credentials, 8+ characters) --------------------------
AWS_ACCESS_KEY_ID=change-me
AWS_SECRET_ACCESS_KEY=change-me
AWS_DEFAULT_REGION=ap-south-1
AWS_ENDPOINT_URL_S3=http://minio:9000

# --- API secrets --------------------------------------------------------------------------------------------------
# Two different random values (openssl rand -hex 32).
JWT_SECRET_KEY=change-me
JWT_REFRESH_SECRET_KEY=change-me
# Fernet key for stored credentials (scan-node credentials, cloud sources): urlsafe base64 of 32 random bytes.
ENCRYPTION_KEY=change-me
CERTIN_HMAC_SECRET=change-me

# --- browser origin and links in mails ------------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000
CBOM_PUBLIC_APP_URL=http://localhost:3000

# --- mail: everything goes to Mailpit (http://localhost:8025) --------------------------------------------------------
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURITY=none
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=devsecshield@local.test

# --- CBOM features (README "CBOM switches"); empty = off ------------------------------------------------------------
# Fleet tab (Sources > Fleet) parts; the tab shows when any of these is on. 1 = on.
CBOM_FLEET_INVENTORY=
CBOM_FLEET_POLICIES=
CBOM_FLEET_MATERIALIZE=
CBOM_FLEET_TRANSPORTS=
CBOM_SSH_CA=
# AWS accounts (Sources > Cloud & identity > AWS). Without CBOM_AWS_PRINCIPAL_ARN the form says "This ZeroShield
# deployment is not set up for AWS collection". The principal is the IAM role or user of YOUR collector account that
# customer roles trust (arn:aws:iam::<12-digit account>:role/<name>); the key pair is that identity's credentials
# (README "Cloud account"). Never commit them.
CBOM_AWS_PRINCIPAL_ARN=
CBOM_AWS_ACCESS_KEY_ID=
CBOM_AWS_SECRET_ACCESS_KEY=
CBOM_AWS_SESSION_TOKEN=
# Identity-provider metadata on a private network: CIDRs and/or host names; a private CA bundle mounted into the
# backend containers; CBOM_LAB_ALLOW_PRIVATE_FETCH=1 lets IdP fetches reach any RFC 1918 address (test labs only).
CBOM_IDP_ALLOWED_PRIVATE=
CBOM_EXTRA_CA_FILE=
CBOM_LAB_ALLOW_PRIVATE_FETCH=
# AI chat on CBOM scans (needs Bedrock credentials; off by default). The CBOM scheduler runs in the cloud worker
# unless CBOM_SCHEDULER=0.
CBOM_ALLOW_LLM=
CBOM_SCHEDULER=1
# AI remediation assistant (optional; see deploy/local/README.md "AI remediation assistant"). Bedrock (only outbound
# call: https to bedrock-runtime.<region>.amazonaws.com): CBOM_AI_PROVIDER=bedrock, CBOM_AI_BEDROCK_REGION,
# CBOM_AI_MODEL (default openai.gpt-oss-120b-1:0), CBOM_AI_AWS_PROFILE, CBOM_AI_BEDROCK_ENDPOINT_URL (PrivateLink).
# Or a model on your network: CBOM_AI_BASE_URL=http://ollama:11434/v1 and CBOM_AI_MODEL=qwen3:8b.
CBOM_AI_PROVIDER=
CBOM_AI_BEDROCK_REGION=
CBOM_AI_AWS_PROFILE=
CBOM_AI_BASE_URL=
CBOM_AI_MODEL=
# Never set CBOM_MTLS_HEADER_TRUSTED here: without nginx in front, any client could send the certificate headers.

# --- other scans (optional) -----------------------------------------------------------------------------------------
# SAST, IaC and the SCA + SBOM chat use Amazon Bedrock and a Qdrant store; without them those scans end as "failed".
# CBOM and AI-BOM code scans need neither. QDRANT_HOST=  QDRANT_PORT=  QDRANT_API_KEY=  LLM_MODEL=
# Self-hosted Git servers for repository scans: host[:port] or http://host[:port].
GIT_ALLOWED_HOSTS=
# DAST targets on private networks (CIDRs and/or host names); cloud metadata stays refused.
DAST_ALLOWED_PRIVATE=
# Public rate limits are used without these.
GITHUB_TOKEN=
NVD_API_KEY=
