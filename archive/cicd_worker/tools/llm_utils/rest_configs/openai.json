{
    "rest": {
       "RestGenerator": {
          "name": "openai",
          "request_timeout": 10000,
          "uri": "https://api.openai.com/v1/responses",
          "method": "post",
          "headers": {
             "Authorization": "Bearer <API_KEY>",
             "Content-Type": "application/json"
          },
          "req_template_json_object": {
            "model": "<MODEL_NAME>",
            "input": "$INPUT"
          },
          "response_json": true,
          "response_json_field": "$.output[0].content[0].text"
       }
    }
 }