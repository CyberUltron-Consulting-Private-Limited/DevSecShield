# Chola production site, rendered by 40-chola-site.sh into /etc/nginx/conf.d/default.conf.
# The ALB ends TLS for both host names and forwards plain HTTP here (port 80 only); its health check asks for
# GET /nginx-health with the instance address as Host, which the default server answers 200 "ok".

# The Server header stays "nginx" without a version (removing it needs a module the stock image lacks); the backend's
# own "server: uvicorn" is not passed on (proxy_pass drops the upstream Server header by default).
server_tokens off;
# Uploads are capped at 50 MB by the API (it answers 413 itself); the one larger route has its own location below.
client_max_body_size 64m;
proxy_read_timeout 600s;           # CI/CD scans hold the request while the worker runs (the ALB idle timeout applies too)
proxy_send_timeout 600s;
# keepalive_timeout stays the image's 65 s (nginx.conf; a second one here is refused as a duplicate): longer than the
# ALB's 60 s idle timeout, so nginx never closes a connection the ALB is about to reuse (that would be a 502).
# Docker's DNS, re-resolved at run time: a recreated container gets a new address and nginx follows it.
resolver 127.0.0.11 valid=10s ipv6=off;

# The client address: set_real_ip_from per ALB subnet, real_ip_header X-Forwarded-For, real_ip_recursive on. nginx takes
# the right-most X-Forwarded-For entry that is not an ALB address, so a client cannot choose its own address.
${DSS_REAL_IP}

# The scheme the browser used. Believed only from the ALB subnets ($realip_remote_addr is the TCP peer, before the
# real-IP rewrite); from anyone else it is this hop's own scheme, http.
geo $realip_remote_addr $dss_from_alb {
    default 0;
${DSS_ALB_GEO}}
map "$dss_from_alb:$http_x_forwarded_proto" $dss_forwarded_proto {
    default $scheme;
    "1:https" https;
    "1:http" http;
}
# HSTS only on responses to HTTPS requests (an empty value sends no header). No includeSubDomains / preload: other
# zeroshield.ai hosts are not ours to pin to HTTPS from here.
map $dss_forwarded_proto $dss_hsts {
    default "";
    https "max-age=31536000";
}
# X-Forwarded-For for the upstream. From the ALB it is the ALB's header as it came (the ALB already appended the
# client, which real_ip made $remote_addr), so the client appears once, last; from anyone else only the TCP peer.
map "$dss_from_alb:$http_x_forwarded_for" $dss_xff {
    default $remote_addr;
    "~^1:(?<alb_xff>.+)$" $alb_xff;
}
# WebSocket upgrades pass through; every other request keeps an empty Connection header.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      '';
}

# Unknown host names (the ALB health check uses the instance address): /nginx-health, everything else closed.
server {
    listen 80 default_server;
    server_name _;
    location = /nginx-health { access_log off; default_type text/plain; return 200 "ok\n"; }
    location / { return 444; }
}

server {
    listen 80;
    server_name ${FRONTEND_HOST};
    add_header Strict-Transport-Security $dss_hsts always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    location = /nginx-health { access_log off; default_type text/plain; return 200 "ok\n"; }
    location / {
        set $frontend http://frontend:3000;
        proxy_pass $frontend;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $dss_xff;
        proxy_set_header X-Forwarded-Proto $dss_forwarded_proto;
        proxy_hide_header X-Powered-By;
    }
}

server {
    listen 80;
    server_name ${API_HOST};
    add_header Strict-Transport-Security $dss_hsts always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    location = /nginx-health { access_log off; default_type text/plain; return 200 "ok\n"; }
    # CBOM export signature check: POST /{team}/cbom/sources/runs/{run}/signature/verify takes an export of up to
    # 512 MB (backend/routers/cbom_run_deliverables.py VERIFY_MAX_BYTES); every other route keeps 64 MB.
    location ~ ^/[0-9]+/cbom/sources/runs/[0-9]+/signature/verify$ {
        client_max_body_size 512m;
        set $backend http://backend:8080;
        proxy_pass $backend;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        # The backend trusts this header only from this proxy's address (FORWARDED_ALLOW_IPS) and takes the
        # right-most address it does not trust; nginx already rewrote $remote_addr to the client (real_ip above).
        proxy_set_header X-Forwarded-For $dss_xff;
        proxy_set_header X-Forwarded-Proto $dss_forwarded_proto;
        # No client certificates through the ALB: an empty value drops whatever a client sent in these headers.
        proxy_set_header X-ZS-Client-Verify "";
        proxy_set_header X-ZS-Client-Cert "";
        # The API sets nosniff on some answers itself; one header, not two. No framework banner either.
        proxy_hide_header X-Content-Type-Options;
        proxy_hide_header X-Powered-By;
        proxy_buffering off;       # streamed responses (chat, server-sent events) reach the browser as they come
    }
    location / {
        set $backend http://backend:8080;
        proxy_pass $backend;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        # The backend trusts this header only from this proxy's address (FORWARDED_ALLOW_IPS) and takes the
        # right-most address it does not trust; nginx already rewrote $remote_addr to the client (real_ip above).
        proxy_set_header X-Forwarded-For $dss_xff;
        proxy_set_header X-Forwarded-Proto $dss_forwarded_proto;
        # No client certificates through the ALB: an empty value drops whatever a client sent in these headers.
        proxy_set_header X-ZS-Client-Verify "";
        proxy_set_header X-ZS-Client-Cert "";
        # The API sets nosniff on some answers itself; one header, not two. No framework banner either.
        proxy_hide_header X-Content-Type-Options;
        proxy_hide_header X-Powered-By;
        proxy_buffering off;       # streamed responses (chat, server-sent events) reach the browser as they come
    }
}
