#!/usr/bin/env python3
"""Fake `helm` for the publish-ghcr.yml release step tests (test_publish_ghcr.py). Every call is appended to
$FAKE_STATE/calls.log (a login's password is read from stdin and recorded only as "<password on stdin>").
  helm package <dir> --version V --app-version A --destination D   writes D/<chart name>-V.tgz holding the chart's
                                                                   values.yaml and the versions (not a real archive)
  helm registry login|logout ...                                   ok
  helm show chart oci://<registry>/<name> --version V              ok when pushed before, else "not found"
                                                                   ($FAKE_STATE/helm-show-error: a registry error)
  helm push <file> oci://<registry>                                stores the file in $FAKE_STATE/oci/<registry>/<name>,
                                                                   prints "Pushed: ..." and "Digest: sha256:<hex>"
Knob: $FAKE_STATE/helm-push-fail (exists): push fails."""
import hashlib
import os
import sys
from pathlib import Path

STATE = Path(os.environ["FAKE_STATE"])


def opt(args, name):
    return args[args.index(name) + 1] if name in args else None


def main(argv):
    with open(STATE / "calls.log", "a") as log:
        if argv[:2] == ["registry", "login"]:
            secret = sys.stdin.read()
            log.write(" ".join(["helm", *argv, "<password on stdin>" if secret else "<no password>"]) + "\n")
        else:
            log.write(" ".join(["helm", *argv]) + "\n")
    if argv[:1] == ["package"]:
        chart = Path(argv[1])
        name = next(line.split(":", 1)[1].strip() for line in (chart / "Chart.yaml").read_text().splitlines()
                    if line.startswith("name:"))
        version, app, dest = opt(argv, "--version"), opt(argv, "--app-version"), Path(opt(argv, "--destination"))
        dest.mkdir(parents=True, exist_ok=True)
        (dest / f"{name}-{version}.tgz").write_text(f"version={version}\nappVersion={app}\n" + (chart / "values.yaml").read_text())
        print(f"Successfully packaged chart and saved it to: {dest / f'{name}-{version}.tgz'}")
        return 0
    if argv[:1] == ["registry"]:
        return 0
    if argv[:2] == ["show", "chart"]:
        ref, version = argv[2], opt(argv, "--version")
        if (STATE / "helm-show-error").exists():
            print("Error: failed to do request: 500 Internal Server Error", file=sys.stderr)
            return 1
        path = STATE / "oci" / ref[len("oci://"):].rsplit("/", 1)[0] / f"{ref.rsplit('/', 1)[1]}-{version}.tgz"
        if not path.exists():
            print(f"Error: {ref[len('oci://'):]}:{version}: not found", file=sys.stderr)
            return 1
        print(f"name: {ref.rsplit('/', 1)[1]}\nversion: {version}")
        return 0
    if argv[:1] == ["push"]:
        if (STATE / "helm-push-fail").exists():
            print("Error: unexpected status from POST request: 403 Forbidden", file=sys.stderr)
            return 1
        src, target = Path(argv[1]), argv[2]
        assert target.startswith("oci://"), target
        out = STATE / "oci" / target[len("oci://"):]
        out.mkdir(parents=True, exist_ok=True)
        data = src.read_bytes()
        (out / src.name).write_bytes(data)
        print(f"Pushed: {target[len('oci://'):]}/{src.name}")
        print(f"Digest: sha256:{hashlib.sha256(data).hexdigest()}")
        return 0
    print(f"fake helm: unsupported {argv}", file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
