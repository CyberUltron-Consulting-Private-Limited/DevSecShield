# DevSecShield guardrail worker image (guardrail_worker_queue). Names come from the code's os.getenv/os.environ
# reads. Placeholder values only; never commit real values (docs/security/secret-rotation.md).

IS_DOCKER_CONTAINER=True

# --- RabbitMQ (Celery broker) --------------------------------------------------------------------------------------
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBIT_ADMIN_USERNAME=devsecshield
RABBIT_ADMIN_PASSWORD=change-me

# --- MongoDB (Celery results) -------------------------------------------------------------------------------------------
# Either a full URL, or leave it empty and the worker builds it from the MONGO_* values below.
RABBIT_MONGO_CONNECTION_URL=
MONGO_HOST=mongo
MONGO_PORT=27017
MONGO_INITDB_ROOT_USERNAME=devsecshield
MONGO_INITDB_ROOT_PASSWORD=change-me
