__pycache__/
*.pyc
*.pyo
*.pyd
*.pyw
*.pyz
*.pywz
*.pyzw
*.pyzwz
*.pyzwzw
*.pyzwzwz
*.pyzwzwzw
*.pyzwzwzwz
node_modules/
.venv/
.skill-workspace/
backend/_migrations/*
!backend/_migrations/.gitkeep
load_testing/
# ruflo runtime (never commit)
*.rvf
*.rvf.lock
ruvector.db
**/ruvector.db
.swarm/
**/memory.db*
agentdb.rvf*
.claude-flow/*
.claude/*
.agents/*

# Secrets: no NEW env file or private key may be added. Files already tracked stay tracked (an ignore rule does not
# untrack them); their values are in git history and are rotated (docs/security/secret-rotation.md). Names of the
# variables go in .env.example files.
.env
.env.*
!.env.example
*.pem
*.key
# Deliberate detection fixtures: planted secrets/keys that the scanners' tests must find.
!aibom/tests/fixtures/**/.env
!aibom/tests/fixtures/**/.env.*
!aibom/tests/fixtures/**/*.pem
!aibom/tests/fixtures/**/*.key
!aibom/examples/shadow-demo/.env
# Staging deploy: env files (.env, backend.env), TLS certificates and saved image archives
deploy/staging/*.env
deploy/staging/certs/
deploy/staging/images/
deploy/staging/deploy-history
deploy/staging/releases/
deploy/staging/node-artifacts/
# Scan-node release archives (scripts/release/scan_node_image.sh)
dist/scan-node/

# Cursor debug-mode traces (they recorded credential fragments once)
.cursor/debug-*.log

# Local git worktrees. Three were once committed as gitlinks (mode 160000) with no .gitmodules, which made every
# actions/checkout fail with "No url found for submodule path". The benchmark clone directories had the same problem;
# they were already ignored by bench/.gitignore and bench/cbom/.gitignore, and the bench scripts clone on demand.
/.worktrees/
